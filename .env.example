SPACETRACK_USER=
SPACETRACK_PASS=
# GUARDRAIL_PATH=C:/path/to/defiant-guardrail/packages/guardrail-core-python
# Live fetches require separate owner authorization; default is offline.
DS_LIVE_ENABLED=0
# Explicit stable cohort, 1..50 distinct TLE-compatible IDs. No automatic discovery.
DS_CATALOG_IDS=
# Minimum 3600 seconds; a 60-second request budget is added to the cooldown.
DS_REFRESH_SECONDS=3600
# Screening settings, not calibrated probability thresholds:
DS_THRESHOLD_KM=10
DS_MAX_AGE_HOURS=72
DS_MAX_GAP_HOURS=72
DS_RETENTION_DAYS=30
DS_SETS_PER_OBJECT=32
DS_MAX_OBJECTS=500
# Default: repository-relative data/element_history.sqlite3
# DS_HISTORY_PATH=C:/path/to/element_history.sqlite3
